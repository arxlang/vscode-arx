{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Arx",
  "scopeName": "source.arx",
  "patterns": [
    {
      "include": "#docstrings"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#annotations"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#types"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "docstrings": {
      "patterns": [
        {
          "name": "comment.block.documentation.arx",
          "contentName": "comment.block.documentation.content.arx",
          "begin": "```",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.arx"
            }
          },
          "end": "```",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.arx"
            }
          },
          "patterns": [
            {
              "name": "meta.mapping.key-value.douki.arx",
              "match": "^(\\s*)([A-Za-z_][\\w-]*)(\\s*:)(\\s*)(.*?)(\\s*)$",
              "captures": {
                "2": {
                  "name": "comment.block.documentation.key.arx"
                },
                "3": {
                  "name": "punctuation.separator.key-value.douki.arx"
                },
                "5": {
                  "name": "comment.block.documentation.value.arx"
                }
              }
            },
            {
              "name": "meta.sequence.item.douki.arx",
              "match": "^(\\s*-\\s+)(.*?)(\\s*)$",
              "captures": {
                "1": {
                  "name": "punctuation.definition.list-item.douki.arx"
                },
                "2": {
                  "name": "comment.block.documentation.value.arx"
                }
              }
            }
          ]
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.arx",
          "match": "(#)(.*)$",
          "captures": {
            "1": {
              "name": "punctuation.definition.comment.arx"
            },
            "2": {
              "name": "comment.line.number-sign.content.arx"
            }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.arx",
          "match": "\"(?:\\\\.|[^\"\\\\\\n])*\""
        },
        {
          "name": "invalid.illegal.unterminated-string.arx",
          "match": "\"(?:\\\\.|[^\"\\\\\\n])*$"
        },
        {
          "name": "invalid.illegal.empty-character.arx",
          "match": "''"
        },
        {
          "name": "constant.character.quoted.single.arx",
          "match": "'(?:\\\\.|[^'\\\\\\n])'"
        },
        {
          "name": "invalid.illegal.character-too-long.arx",
          "match": "'(?:\\\\.|[^'\\\\\\n]){2,}'"
        },
        {
          "name": "invalid.illegal.unterminated-character.arx",
          "match": "'(?:\\\\.|[^'\\\\\\n])*$"
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "name": "meta.annotation.modifiers.arx",
          "begin": "@\\[",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.annotation.begin.arx"
            }
          },
          "end": "\\]",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.annotation.end.arx"
            }
          },
          "patterns": [
            {
              "include": "#modifiers"
            },
            {
              "include": "#punctuation"
            }
          ]
        },
        {
          "name": "meta.template.parameters.arx",
          "begin": "@<",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.template.begin.arx"
            }
          },
          "end": ">",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.template.end.arx"
            }
          },
          "patterns": [
            {
              "include": "#keywords"
            },
            {
              "include": "#types"
            },
            {
              "include": "#constants"
            },
            {
              "include": "#operators"
            },
            {
              "include": "#punctuation"
            }
          ]
        }
      ]
    },
    "modifiers": {
      "patterns": [
        {
          "name": "storage.modifier.arx",
          "match": "\\b(?:protected|abstract|private|public)\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "meta.function.definition.arx",
          "match": "\\b(fn)\\s+((?:[_\\p{L}])(?:[_\\p{L}\\p{N}])*)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.arx"
            },
            "2": {
              "name": "entity.name.function.arx"
            }
          }
        },
        {
          "name": "meta.extern.definition.arx",
          "match": "\\b(extern)\\s+((?:[_\\p{L}])(?:[_\\p{L}\\p{N}])*)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.arx"
            },
            "2": {
              "name": "entity.name.function.arx"
            }
          }
        },
        {
          "name": "meta.class.definition.arx",
          "match": "\\b(class)\\s+((?:[_\\p{L}])(?:[_\\p{L}\\p{N}])*)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.arx"
            },
            "2": {
              "name": "entity.name.type.class.arx"
            }
          }
        },
        {
          "name": "meta.type.alias.arx",
          "match": "\\b(type)\\s+((?:[_\\p{L}])(?:[_\\p{L}\\p{N}])*)\\b",
          "captures": {
            "1": {
              "name": "keyword.declaration.type.arx"
            },
            "2": {
              "name": "entity.name.type.alias.arx"
            }
          }
        },
        {
          "name": "meta.variable.declaration.arx",
          "match": "(^[ \\t]*)((?:[_\\p{L}])(?:[_\\p{L}\\p{N}])*)([ \\t]*)(:)([ \\t]*)(?:((?:protected|abstract|private|extern|public|static|const|var))[ \\t]*(::)[ \\t]*)?",
          "captures": {
            "2": {
              "name": "variable.other.definition.arx"
            },
            "4": {
              "name": "punctuation.separator.arx"
            },
            "6": {
              "name": "storage.modifier.arx"
            },
            "7": {
              "name": "keyword.operator.arx"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.arx",
          "match": "\\b(?:continue|finally|assert|except|extern|import|return|break|class|const|raise|while|elif|else|then|with|for|try|var|fn|if|in)\\b"
        },
        {
          "name": "keyword.other.contextual.arx",
          "match": "\\b(?:operator|binary|unary|auto|from|type|as)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.arx",
          "match": "\\b(?:false|none|true)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.class.builtin.arx",
          "match": "\\b(?:File)\\b"
        },
        {
          "name": "support.type.builtin.arx",
          "match": "\\b(?:arrow_struct|large_binary|large_string|arrow_list|decimal128|decimal256|dictionary|fixed_list|large_list|arrow_map|dataframe|timestamp|datetime|nullable|sequence|boolean|float16|float32|float64|binary|series|string|tensor|bytes|int16|int32|int64|bool|char|date|file|int8|list|none|time|f16|f32|f64|i16|i32|i64|str|u16|u32|u64|i8|u8)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.decimal.arx",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.float.decimal.arx",
          "match": "(?<![\\w.])\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.float.decimal.arx",
          "match": "\\b\\d+\\.(?!\\.)"
        },
        {
          "name": "constant.numeric.integer.decimal.arx",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arx",
          "match": "(?:--|-=|->|::|!=|\\*=|/=|&&|%=|\\+\\+|\\+=|<=|==|>=|\\|\\|)"
        },
        {
          "name": "keyword.operator.word.arx",
          "match": "\\b(?:and|not|or)\\b"
        },
        {
          "name": "keyword.operator.arx",
          "match": "[=<>+\\-*/%!|]"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.builtin.arx",
          "match": "\\b(?:(?:wrapping_cast|series_count|wrapping_add|wrapping_mul|wrapping_sub|series_mean|isinstance|series_all|series_any|series_max|series_min|series_sum|dataframe|fill_null|timestamp|datetime|is_null|bytes|print|range|cast|date|list|open|time|type|int|len|ord))\\b(?=\\s*(?:<[^>\\n]+>\\s*)?\\()"
        },
        {
          "name": "support.function.arx",
          "match": "\\b(?!\\b(?:arrow_struct|large_binary|large_string|arrow_list|decimal128|decimal256|dictionary|fixed_list|large_list|arrow_map|dataframe|timestamp|continue|datetime|nullable|operator|sequence|boolean|finally|float16|float32|float64|assert|binary|except|extern|import|return|series|string|tensor|break|bytes|class|const|false|int16|int32|int64|raise|unary|while|auto|bool|char|date|elif|else|file|File|from|int8|list|none|then|time|true|type|with|and|f16|f32|f64|for|i16|i32|i64|not|str|try|u16|u32|u64|var|as|fn|i8|if|in|or|u8)\\b)(?:(?:[_\\p{L}])(?:[_\\p{L}\\p{N}])*)(?=\\s*(?:<[^>\\n]+>\\s*)?\\()"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.arx",
          "match": "[:,;.]"
        },
        {
          "name": "punctuation.definition.annotation.begin.arx",
          "match": "@(?=\\[|<)"
        },
        {
          "name": "punctuation.section.brackets.begin.arx",
          "match": "[\\(\\{\\[]"
        },
        {
          "name": "punctuation.section.brackets.end.arx",
          "match": "[\\)\\}\\]]"
        }
      ]
    }
  }
}
