{
  "name": "vscode-arx",
  "displayName": "ArxLang",
  "description": "Highlight-only VS Code extension for the Arx programming language.",
  "version": "0.3.2",
  "publisher": "arxlang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/arxlang/vscode-arx.git"
  },
  "homepage": "https://github.com/arxlang/vscode-arx#readme",
  "bugs": {
    "url": "https://github.com/arxlang/vscode-arx/issues"
  },
  "icon": "images/icon.png",
  "files": [
    "language-configuration.json",
    "syntaxes/**",
    "syntax/arx.syntax.json",
    "images/**",
    "README.md",
    "LICENSE"
  ],
  "categories": [
    "Programming Languages"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "arx",
        "aliases": [
          "ArxLang",
          "Arx",
          "arx"
        ],
        "extensions": [
          ".x",
          ".arx"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/arx-file-icon-light.png",
          "dark": "./images/arx-file-icon-dark.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "arx",
        "scopeName": "source.arx",
        "path": "./syntaxes/arx.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": [
              "comment.block.documentation.arx",
              "comment.block.documentation.key.arx",
              "punctuation.definition.comment.begin.arx",
              "punctuation.definition.comment.end.arx",
              "punctuation.separator.key-value.douki.arx"
            ],
            "settings": {
              "foreground": "#6E7681"
            }
          },
          {
            "scope": [
              "comment.line.number-sign.content.arx",
              "comment.block.documentation.value.arx"
            ],
            "settings": {
              "foreground": "#8FA7B3"
            }
          }
        ]
      }
    }
  },
  "scripts": {
    "sync:syntax": "bash ./scripts/sync-syntax.sh",
    "build:grammar": "node ./scripts/build-grammar.mjs --write",
    "check:grammar": "node ./scripts/build-grammar.mjs --check",
    "build:vsix": "bash ./scripts/build.sh --no-dependencies",
    "publish:all": "bash ./scripts/publish.sh --all --no-dependencies",
    "release:dry-run": "bash ./scripts/semantic-release.sh --dry-run",
    "release:ci": "bash ./scripts/semantic-release.sh --ci"
  },
  "author": {
    "name": "Ivan Ogasawara",
    "email": "ivan.ogasawara@gmail.com"
  }
}
